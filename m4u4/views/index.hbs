<h1>{{title}}</h1>
{{#if conocido}}
<p>Hola {{nombre}}</p>
    {{#if mayor}}
    <h1>Podés ingresar ya que sos mayor de edad.</h1>
    {{/if}}
    {{#unless mayor}}
    <h1>No podés ingresar ya que sos menor de edad.</h1>
    {{/unless}}
    
<a href="/salir">Salir</a></p>

{{/if}}

{{#unless conocido}}
<p>Debes ingresar tu nombre y edad para continuar.</p>
<form action="/ingresar" method="post">
    <label>Nombre</label><input type="text" name="nombre"></p>
    <label>Edad</label><input type="number" name="edad"></p>
    <button>Ingresar</button>
</form>
{{/unless}}
